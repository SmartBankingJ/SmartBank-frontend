<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<StackPane fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ma.bankdirect.PrimaryController" styleClass="auth-root">
    <Pane fx:id="backdrop" mouseTransparent="true" managed="false">
        <Circle fx:id="outerRing" styleClass="outer-ring" />
        <Circle fx:id="innerRing" styleClass="inner-ring" />
        <Polygon fx:id="facet" styleClass="background-facet" />
        <Ellipse fx:id="blueWave" styleClass="blue-wave" />
    </Pane>
    <BorderPane>
        <top>
            <HBox alignment="CENTER_LEFT" styleClass="topbar" spacing="14">
                <StackPane styleClass="brand-mark" minWidth="40" prefWidth="40" minHeight="40" prefHeight="40">
                    <SVGPath content="M 0 6 L 12 0 L 24 6 L 24 9 L 0 9 Z M 3 12 L 7 12 L 7 24 L 3 24 Z M 10 12 L 14 12 L 14 24 L 10 24 Z M 17 12 L 21 12 L 21 24 L 17 24 Z M 0 27 L 24 27 L 24 30 L 0 30 Z" styleClass="brand-icon" />
                </StackPane>
                <VBox spacing="2">
                    <Label text="SMARTBANKING" styleClass="brand-name" />
                    <Label text="VOTRE ESPACE BANCAIRE" styleClass="brand-caption" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label text="ESPACE CLIENT" styleClass="topbar-caption" />
                <Label text="FR" styleClass="language-pill" accessibleText="Langue de l’interface : français" />
            </HBox>
        </top>
        <center>
            <HBox alignment="CENTER" spacing="58" styleClass="main-content">
                <VBox alignment="CENTER_LEFT" spacing="24" minWidth="300" prefWidth="410" maxWidth="480" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="9" styleClass="hero-eyebrow">
                        <Circle radius="4" styleClass="status-dot" />
                        <Label text="BIENVENUE CHEZ VOUS" styleClass="eyebrow-text" />
                    </HBox>
                    <Label text="Votre banque.&#10;À portée de main." styleClass="hero-title" wrapText="true" />
                    <Label text="Vos comptes, vos projets et vos opérations.&#10;Un seul espace pour garder le contrôle." styleClass="hero-description" wrapText="true" />
                    <Region prefHeight="8" />
                    <HBox spacing="14" alignment="CENTER_LEFT">
                        <StackPane styleClass="shield-tile" minWidth="46" minHeight="48">
                            <SVGPath content="M 12 0 L 23 4 L 23 13 C 23 20 18 25 12 28 C 6 25 1 20 1 13 L 1 4 Z M 7 13 L 11 17 L 18 9" styleClass="shield-icon" />
                        </StackPane>
                        <VBox spacing="5">
                            <Label text="Un accès personnel" styleClass="trust-title" />
                            <Label text="Gardez vos identifiants confidentiels." styleClass="trust-description" />
                        </VBox>
                    </HBox>
                </VBox>
                <VBox fx:id="loginCard" alignment="CENTER_LEFT" minWidth="420" prefWidth="450" maxWidth="450" styleClass="login-card">
                    <Label text="MON ESPACE CLIENT" styleClass="card-eyebrow" />
                    <Label text="Se connecter" styleClass="card-title" />
                    <Label text="Heureux de vous retrouver." styleClass="card-subtitle" />
                    <HBox spacing="4" styleClass="required-note">
                        <Label text="*" styleClass="required-star" />
                        <Label text="Information obligatoire" />
                    </HBox>
                    <Label text="Identifiant *" styleClass="field-label" labelFor="$usernameField" />
                    <HBox styleClass="field-row" spacing="12" alignment="CENTER_LEFT">
                        <SVGPath content="M 12 1 A 5 5 0 1 0 12 11 A 5 5 0 1 0 12 1 M 2 26 C 2 12 22 12 22 26 Z" styleClass="field-icon" />
                        <TextField fx:id="usernameField" promptText="Votre identifiant" onAction="#focusPassword" HBox.hgrow="ALWAYS" />
                    </HBox>
                    <Label text="Mot de passe *" styleClass="field-label,password-label" labelFor="$passwordField" />
                    <HBox styleClass="field-row" spacing="12" alignment="CENTER_LEFT">
                        <SVGPath content="M 5 11 L 5 6 C 5 -1 19 -1 19 6 L 19 11 M 2 11 L 22 11 L 22 29 L 2 29 Z M 12 18 L 12 23" styleClass="field-icon" />
                        <StackPane HBox.hgrow="ALWAYS">
                            <PasswordField fx:id="passwordField" promptText="Votre mot de passe" onAction="#submitLogin" />
                            <TextField fx:id="visiblePasswordField" visible="false" managed="false" promptText="Votre mot de passe" onAction="#submitLogin" accessibleText="Mot de passe affiché" />
                        </StackPane>
                        <Button fx:id="visibilityButton" onAction="#togglePasswordVisibility" styleClass="eye-button" accessibleText="Afficher le mot de passe">
                            <graphic><SVGPath fx:id="eyeIcon" content="M 1 12 C 6 2 18 2 23 12 C 18 22 6 22 1 12 Z M 12 8 A 4 4 0 1 0 12 16 A 4 4 0 1 0 12 8 M 2 2 L 22 22" styleClass="eye-icon" /></graphic>
                        </Button>
                    </HBox>
                    <Label fx:id="feedbackLabel" visible="false" managed="false" wrapText="true" styleClass="feedback" maxWidth="Infinity" />
                    <Button fx:id="loginButton" text="Se connecter" onAction="#submitLogin" disable="true" maxWidth="Infinity" styleClass="login-button" />
                    <Hyperlink text="Je ne peux pas me connecter" onAction="#showAccessHelp" styleClass="recovery-link" maxWidth="Infinity" alignment="CENTER" />
                    <HBox alignment="CENTER" spacing="8" styleClass="card-footer">
                        <SVGPath content="M 3 8 L 3 5 C 3 -1 13 -1 13 5 L 13 8 M 1 8 L 15 8 L 15 20 L 1 20 Z" styleClass="small-lock" />
                        <Label text="Ne partagez jamais votre mot de passe." />
                    </HBox>
                </VBox>
            </HBox>
        </center>
        <bottom>
            <HBox alignment="CENTER_LEFT" spacing="18" styleClass="bottom-bar">
                <Label text="SmartBanking" styleClass="footer-brand" />
                <Label text="Projet pédagogique · Données de démonstration" styleClass="footer-caption" />
                <Region HBox.hgrow="ALWAYS" />
                <MenuButton text="Plus d’options" styleClass="options-button">
                    <items>
                        <MenuItem text="Conseils de sécurité" onAction="#showSecurityAdvice" />
                        <MenuItem text="À propos de SmartBanking" onAction="#showAbout" />
                    </items>
                </MenuButton>
                <Button text="Devenir client" onAction="#showCustomerInformation" styleClass="customer-button" />
            </HBox>
        </bottom>
    </BorderPane>
</StackPane>
