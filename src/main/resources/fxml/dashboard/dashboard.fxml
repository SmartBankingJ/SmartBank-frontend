<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ma.bankdirect.controller.dashboard.DashboardController"
            prefWidth="1180.0" prefHeight="780.0"
            styleClass="dashboard-root" stylesheets="@dashboard.css">

    <left>
        <VBox prefWidth="250.0" minWidth="230.0" spacing="22.0" styleClass="sidebar">
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="brand-block">
                <StackPane prefWidth="46.0" prefHeight="46.0" styleClass="brand-mark">
                    <Label text="S" styleClass="brand-mark-letter"/>
                </StackPane>
                <VBox spacing="3.0">
                    <Label text="SMARTBANKING" styleClass="brand-name"/>
                    <Label text="VOTRE ESPACE BANCAIRE" styleClass="brand-caption"/>
                </VBox>
            </HBox>

            <Label text="MENU PRINCIPAL" styleClass="sidebar-heading"/>
            <VBox spacing="7.0">
                <Button text="⌂   Accueil" maxWidth="Infinity" styleClass="nav-button-active"/>
                <Button text="◫   Ma situation" onAction="#onSituationClicked" maxWidth="Infinity" styleClass="nav-button"/>
                <Button text="⇄   Transactions" onAction="#onTransactionsClicked" maxWidth="Infinity" styleClass="nav-button"/>
                <Button text="▤   Mes produits" onAction="#onProductsClicked" maxWidth="Infinity" styleClass="nav-button"/>
                <Button text="⚙   Paramètres" onAction="#onMenuClicked" maxWidth="Infinity" styleClass="nav-button"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="12.0" styleClass="sidebar-bottom">
                <VBox spacing="8.0" styleClass="advisor-card">
                    <Label text="VOTRE CONSEILLÈRE" styleClass="advisor-heading"/>
                    <HBox alignment="CENTER_LEFT" spacing="10.0" onMouseClicked="#onAdvisorClicked" style="-fx-cursor: hand;">
                        <StackPane prefWidth="34.0" prefHeight="34.0" styleClass="advisor-avatar">
                            <Label text="M" styleClass="advisor-avatar-letter"/>
                        </StackPane>
                        <VBox spacing="2.0">
                            <Label fx:id="advisorNameLabel" text="Mme Malika Ezzakri" styleClass="advisor-name"/>
                            <Label text="À votre écoute" styleClass="advisor-caption"/>
                        </VBox>
                    </HBox>
                    <Button text="Démarrer le chat" onAction="#onLiveChatClicked" maxWidth="Infinity" styleClass="chat-button"/>
                </VBox>
                <Button text="⇥   Se déconnecter" onAction="#onLogout" maxWidth="Infinity" styleClass="logout-button"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dashboard-scroll">
            <content>
                <VBox spacing="24.0" styleClass="dashboard-content">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <VBox spacing="5.0">
                            <Label text="MON ESPACE CLIENT" styleClass="eyebrow"/>
                            <Label text="Tableau de bord" styleClass="page-title"/>
                            <Label text="Session authentifiée · Soldes et opérations de démonstration" styleClass="page-subtitle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox alignment="CENTER" spacing="8.0" styleClass="language-chip">
                            <Label text="FR" styleClass="language-text"/>
                        </HBox>
                    </HBox>

                    <HBox spacing="18.0" styleClass="account-row">
                        <VBox spacing="18.0" HBox.hgrow="ALWAYS" styleClass="account-card-primary">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <StackPane prefWidth="42.0" prefHeight="42.0" styleClass="account-icon-light">
                                    <Label text="▣" styleClass="account-icon-glyph"/>
                                </StackPane>
                                <VBox spacing="3.0">
                                    <Label text="COMPTE COURANT" styleClass="account-kicker-light"/>
                                    <Label text="Compte chèque particulier" styleClass="account-title-light"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="ACTIF" styleClass="status-pill-light"/>
                            </HBox>
                            <VBox spacing="4.0">
                                <Label text="SOLDE DISPONIBLE" styleClass="balance-caption-light"/>
                                <Label fx:id="currentBalanceLabel" text="24 500,00 MAD" styleClass="balance-value-light"/>
                            </VBox>
                            <HBox alignment="CENTER_LEFT">
                                <Label text="RIB" styleClass="rib-caption-light"/>
                                <Label fx:id="currentRibLabel" text="0117 ... 1234" styleClass="rib-value-light"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Voir le relevé   ›" onAction="#onSituationClicked" styleClass="text-button-light"/>
                            </HBox>
                        </VBox>

                        <VBox prefWidth="285.0" minWidth="245.0" spacing="17.0" styleClass="account-card-secondary">
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <StackPane prefWidth="40.0" prefHeight="40.0" styleClass="account-icon-teal">
                                    <Label text="◌" styleClass="account-icon-glyph-teal"/>
                                </StackPane>
                                <VBox spacing="3.0">
                                    <Label text="ÉPARGNE" styleClass="account-kicker"/>
                                    <Label text="Compte sur carnet" styleClass="account-title"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="ACTIF" styleClass="status-pill-teal"/>
                            </HBox>
                            <VBox spacing="5.0">
                                <Label text="120 000,00 MAD" styleClass="balance-value"/>
                                <Label text="RIB : 0117 ... 9876" styleClass="rib-caption"/>
                            </VBox>
                            <Button text="Effectuer un virement" onAction="#onTransactionsClicked" maxWidth="Infinity" styleClass="primary-action"/>
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="Activité récente" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Toutes les opérations   ›" onAction="#onTransactionsClicked" styleClass="text-button"/>
                    </HBox>

                    <VBox spacing="0.0" styleClass="activity-panel">
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="activity-header">
                            <Label text="VOS DERNIÈRES OPÉRATIONS" styleClass="table-heading"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="3 opérations" styleClass="muted-caption"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="activity-row">
                            <StackPane prefWidth="36.0" prefHeight="36.0" styleClass="transaction-icon">
                                <Label text="↗" styleClass="transaction-icon-glyph"/>
                            </StackPane>
                            <VBox spacing="3.0">
                                <Label fx:id="opLabel1" text="Virement vers bénéficiaire" styleClass="transaction-title"/>
                                <Label fx:id="opDate1" text="19/11" styleClass="transaction-date"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="opAmount1" text="- 500,00 MAD" styleClass="transaction-amount"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="activity-row">
                            <StackPane prefWidth="36.0" prefHeight="36.0" styleClass="transaction-icon">
                                <Label text="↗" styleClass="transaction-icon-glyph"/>
                            </StackPane>
                            <VBox spacing="3.0">
                                <Label fx:id="opLabel2" text="Virement vers bénéficiaire" styleClass="transaction-title"/>
                                <Label fx:id="opDate2" text="19/11" styleClass="transaction-date"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="opAmount2" text="- 1 200,00 MAD" styleClass="transaction-amount"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="activity-row-last">
                            <StackPane prefWidth="36.0" prefHeight="36.0" styleClass="transaction-icon-card">
                                <Label text="▤" styleClass="transaction-icon-glyph"/>
                            </StackPane>
                            <VBox spacing="3.0">
                                <Label fx:id="opLabel3" text="Paiement par carte" styleClass="transaction-title"/>
                                <Label fx:id="opDate3" text="18/11" styleClass="transaction-date"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="opAmount3" text="- 350,00 MAD" styleClass="transaction-amount"/>
                        </HBox>
                    </VBox>

                    <HBox spacing="18.0">
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS" styleClass="info-panel">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="Demandes en cours" styleClass="info-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="0" styleClass="count-badge"/>
                            </HBox>
                            <Label text="Aucun virement en attente pour le moment." wrapText="true" styleClass="info-description"/>
                        </VBox>
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS" styleClass="info-panel">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="Notifications" styleClass="info-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="À jour" styleClass="notification-badge"/>
                            </HBox>
                            <Label text="Vous êtes à jour. Aucune nouvelle notification." wrapText="true" styleClass="info-description"/>
                        </VBox>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
